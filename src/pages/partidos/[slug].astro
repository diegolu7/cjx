---
import Layout from "../../layouts/Layout.astro";
import Notifications from "../../components/Notifications.astro";
import MatchHero from "../../components/match/MatchHero.astro";
import MatchEssentials from "../../components/match/MatchEssentials.astro";
import MatchPreview from "../../components/match/MatchPreview.astro";
import MatchKeyFacts from "../../components/match/MatchKeyFacts.astro";
import RecentForm from "../../components/match/RecentForm.astro";
import Lineups from "../../components/match/Lineups.astro";
import MatchEvents from "../../components/match/MatchEvents.astro";
import TechnicalDetails from "../../components/match/TechnicalDetails.astro";
import type { Match } from "../../types/match";
import {
  rivalOf,
  titleFor,
  descriptionFor,
  autoPrevia,
  recentResults,
} from "../../lib/match";
import data from "../../data/matches.json";

export async function getStaticPaths() {
  const matches = data.matches as Match[];
  return matches.map((m) => ({ params: { slug: m.slug }, props: { match: m } }));
}

const { match } = Astro.props as { match: Match };
const base = import.meta.env.BASE_URL;

const allMatches = data.matches as Match[];
const rival = rivalOf(match);
const d = match.details;
const finished = match.status === "finished";
const upcoming = !finished;
const noindex = !match.indexable;

const previa = d?.preview ?? (upcoming ? autoPrevia(match) : undefined);
const previewTitle = finished ? "Resumen del partido" : "Previa del partido";
const form = recentResults(allMatches, 3);
const eventos = d?.events ?? [];

const sportsEvent = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  name: `Boca vs ${rival}`,
  startDate: `${match.date}T${match.time ?? "00:00"}:00-03:00`,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  sport: "Soccer",
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(`${base}og.png`, Astro.site).href,
  description: descriptionFor(match),
  ...(match.venue ? { location: { "@type": "Place", name: match.venue } } : {}),
  competitor: [
    { "@type": "SportsTeam", name: "Boca Juniors", sport: "Soccer" },
    { "@type": "SportsTeam", name: rival, sport: "Soccer" },
  ],
  organizer: { "@type": "Organization", name: match.competition },
};
---

<Layout title={titleFor(match)} description={descriptionFor(match)} noindex={noindex}>
  <nav class="mb-4 text-[12px] text-text-muted" aria-label="Migas de pan">
    <a href={`${base}`} class="hover:text-accent underline underline-offset-2">Inicio</a>
    <span> / </span>
    <a href={`${base}partidos`} class="hover:text-accent underline underline-offset-2">Partidos</a>
  </nav>

  <article>
    <h1 class="sr-only">
      {finished ? `${match.homeTeam} ${match.homeScore} - ${match.awayScore} ${match.awayTeam}` : `Boca vs ${rival}`}
    </h1>

    <MatchHero match={match} />

    {upcoming && (
      <div class="mt-4">
        <Notifications compact />
      </div>
    )}

    <div class="mt-6">
      <MatchEssentials match={match} details={d} />
    </div>

    {previa && <MatchPreview title={previewTitle} text={previa} />}

    <MatchKeyFacts facts={d?.facts} h2h={d?.h2h} notes={d?.notes} />

    <RecentForm results={form} />

    <Lineups match={match} details={d} upcoming={upcoming} />

    {finished && eventos.length > 0 && <MatchEvents events={eventos} rival={rival} />}

    {finished && <TechnicalDetails match={match} details={d} />}

    {!d && finished && (
      <p class="text-[13px] leading-[1.6] text-text-muted border border-border bg-surface rounded-md px-4 py-3">
        Todavía no hay contenido ampliado de este partido. La ficha y el resultado se actualizan
        automáticamente.
      </p>
    )}

    <p class="mt-8">
      <a
        href={`${base}partidos`}
        class="text-[13px] text-accent-secondary underline underline-offset-2 hover:text-text-primary"
      >
        ← Volver a todos los partidos
      </a>
    </p>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(sportsEvent)} />
</Layout>
