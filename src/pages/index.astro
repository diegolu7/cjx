---
import Layout from "../layouts/Layout.astro";
import MatchesTimeline from "../components/MatchesTimeline.astro";
import Notifications from "../components/Notifications.astro";
import ShareButton from "../components/ShareButton.astro";
import type { Match } from "../types/match";
import { fechaHoraCorta } from "../lib/match";
import data from "../data/matches.json";

const base = import.meta.env.BASE_URL;
const matches = data.matches as Match[];
const next = matches.find((m) => m.status === "next");

const rival = next ? (next.homeTeam === "Boca" ? next.awayTeam : next.homeTeam) : "";
const startDate = next ? `${next.date}T${next.time ?? "00:00"}:00-03:00` : null;
const endDate = startDate
  ? new Date(new Date(startDate).getTime() + 2 * 60 * 60 * 1000).toISOString()
  : null;

const sportsEvent = next
  ? {
      "@context": "https://schema.org",
      "@type": "SportsEvent",
      name: `${next.homeTeam} vs ${next.awayTeam}`,
      startDate,
      endDate,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      sport: "Soccer",
      url: new URL(Astro.url.pathname, Astro.site).href,
      image: new URL(`${base}og.png`, Astro.site).href,
      description: `${next.homeTeam} vs ${next.awayTeam} por ${next.competition}${
        next.round ? ` (${next.round})` : ""
      } el ${next.date}${next.time ? ` a las ${next.time}` : ""} hs.`,
      location: {
        "@type": "Place",
        name: next.venue ?? "Estadio a confirmar",
      },
      competitor: [
        { "@type": "SportsTeam", name: "Boca Juniors", sport: "Soccer" },
        { "@type": "SportsTeam", name: rival, sport: "Soccer" },
      ],
      organizer: { "@type": "Organization", name: next.competition },
    }
  : null;
---

<Layout
  title="Cuándo Juega Boca Juniors — Próximos Partidos y Resultados"
  description="Cuándo juega Boca Juniors: próximo partido, fecha, hora, rival y resultados recientes. Agenda del Xeneize actualizada. Sitio no oficial."
>
  <section class="mb-4">
    <h1 class="text-[24px] lg:text-[30px] font-bold leading-[1.15] tracking-[0.02em] text-text-primary">
      Cuándo juega Boca Juniors
    </h1>
  </section>

  <div id="partidos" class="scroll-mt-6">
    <MatchesTimeline matches={matches} />
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <a
      href={`${base}partidos`}
      class="text-[13px] text-accent-secondary underline underline-offset-2 hover:text-text-primary"
    >
      Ver todos los partidos →
    </a>
    <ShareButton
      url={new URL(Astro.url.pathname, Astro.site).href}
      title="Cuándo juega Boca Juniors"
      text="Cuándo juega Boca: próximos partidos, horarios y resultados"
      label="Compartir"
    />
  </div>

  <Notifications hideWhenUnconfigured />

  <p class="mt-6 text-[11px] text-text-muted">
    Datos actualizados: {fechaHoraCorta(data.updatedAt)} (hora Argentina).
  </p>

  {sportsEvent && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sportsEvent)} />
  )}
</Layout>
