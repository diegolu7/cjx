---
import LegalLayout from "../../layouts/LegalLayout.astro";
import { getDict, type Locale } from "../../i18n/index.ts";
import { localeBase } from "../../i18n/routes";

const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const base = import.meta.env.BASE_URL;
const lbase = localeBase(locale);
const links = dict.pages.contact.links;
---

<LegalLayout title={dict.pages.contact.title} description={dict.pages.contact.description}>
  <p>{dict.pages.contact.intro}</p>
  <p>
    <strong><a href={`mailto:${dict.pages.contact.email}`}>{dict.pages.contact.email}</a></strong>
  </p>

  <h2>{dict.pages.contact.ipTitle}</h2>
  <p>{dict.pages.contact.ipText}</p>

  <h2>{dict.pages.contact.linksTitle}</h2>
  <ul>
    <li><a href={`${lbase}${base}info#quienes-somos`}>{links.about}</a></li>
    <li><a href={`${lbase}${base}terminos`}>{links.terms}</a></li>
    <li><a href={`${lbase}${base}privacidad`}>{links.privacy}</a></li>
    <li><a href={`${lbase}${base}cookies`}>{links.cookies}</a></li>
  </ul>
</LegalLayout>
