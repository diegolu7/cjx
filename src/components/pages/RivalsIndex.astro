---
import Layout from "../../layouts/Layout.astro";
import type { Match } from "../../types/match";
import { groupByRival } from "../../lib/taxonomy";
import { getDict, type Locale } from "../../i18n/index.ts";
import { localeBase } from "../../i18n/routes";
import data from "../../data/matches.json";

const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const base = import.meta.env.BASE_URL;
const lbase = localeBase(locale);
const groups = groupByRival(data.matches as Match[]);
---

<Layout title={dict.pages.rivals.title} description={dict.pages.rivals.description}>
  <h1 class="text-[24px] lg:text-[30px] font-bold leading-[1.15] tracking-[0.02em] text-text-primary">
    {dict.pages.rivals.h1}
  </h1>
  <p class="mt-2 text-[13px] leading-[1.6] text-text-secondary">
    {dict.pages.rivals.intro}
  </p>

  <ul class="mt-5 list-none p-0 m-0 grid grid-cols-1 gap-3 lg:grid-cols-2">
    {groups.map((g) => (
      <li>
        <a
          href={`${lbase}${base}rivales/${g.slug}`}
          class="group flex items-center justify-between gap-3 rounded-lg border border-border bg-surface shadow-card px-4 py-3 transition-all duration-[160ms] hover:-translate-y-px hover:bg-surface-hover hover:border-accent-secondary"
        >
          <span class="text-[14px] font-semibold text-text-primary">{g.name}</span>
          <span class="text-[12px] text-text-muted">
            {g.matches.length}{" "}
            {g.matches.length === 1 ? dict.pages.rivals.one : dict.pages.rivals.many}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
