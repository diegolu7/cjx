---
import LegalLayout from "../../layouts/LegalLayout.astro";
import LegalBlocks from "./LegalBlocks.astro";
import { getDict, type Locale } from "../../i18n/index.ts";
import type { LegalBlock } from "../../i18n/types";
import { localeBase } from "../../i18n/routes";

interface Props {
  /** "cookies" | "privacy" | "terms" */
  doc: "cookies" | "privacy" | "terms";
}
const { doc } = Astro.props;

const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const base = import.meta.env.BASE_URL;
const lbase = localeBase(locale);

const content = dict.pages.legal[doc];
const vars = {
  privacy: `${lbase}${base}privacidad`,
  cookies: `${lbase}${base}cookies`,
};
const replaceVars = (s: string): string =>
  s.replace(/\{(privacy|cookies)\}/g, (m) => vars[m as keyof typeof vars]);

const blocks: LegalBlock[] = content.blocks.map((b) => ({
  type: b.type as LegalBlock["type"],
  text: b.text ? replaceVars(b.text) : undefined,
  items: b.items?.map(replaceVars),
}));
---

<LegalLayout title={content.title} description={content.description}>
  <LegalBlocks blocks={blocks} />
</LegalLayout>
