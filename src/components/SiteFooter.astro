---
// Footer según design.md §45/§46: disclaimer, links legales, contacto y logo.
import LangSwitcher from "./LangSwitcher.astro";
import { getDict, t, type Locale } from "../i18n/index.ts";
import { localeBase } from "../i18n/routes";

const base = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const lbase = localeBase(locale);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-[11px] leading-[1.5] text-text-secondary">
          {dict.footer.disclaimer}
        </p>

        <p class="text-[11px] leading-[1.5] text-text-muted">
          {dict.footer.data}{" "}
          <a href="https://www.espn.com/soccer/" rel="noopener noreferrer nofollow" target="_blank" class="text-text-secondary underline underline-offset-2 hover:text-accent">ESPN</a>.
        </p>

        <nav aria-label={dict.nav.legal} class="flex flex-wrap gap-x-4 gap-y-1">
          <a href={`${lbase}${base}info`} class="text-[11px] text-text-secondary underline underline-offset-2 hover:text-accent">{dict.nav.info}</a>
          <a href={`${lbase}${base}terminos`} class="text-[11px] text-text-secondary underline underline-offset-2 hover:text-accent">{dict.footer.terms}</a>
          <a href={`${lbase}${base}privacidad`} class="text-[11px] text-text-secondary underline underline-offset-2 hover:text-accent">{dict.footer.privacy}</a>
          <a href={`${lbase}${base}cookies`} class="text-[11px] text-text-secondary underline underline-offset-2 hover:text-accent">{dict.footer.cookiesLink}</a>
          <a href={`${lbase}${base}contacto`} class="text-[11px] text-text-secondary underline underline-offset-2 hover:text-accent">{dict.footer.contact}</a>
        </nav>

        <p class="text-[11px] leading-[1.5] text-text-muted">
          {dict.footer.cookiesText}{" "}
          <a href={`${lbase}${base}cookies`} class="underline underline-offset-2 hover:text-accent">{dict.footer.cookiesPolicy}</a>.
        </p>

        <p class="text-[11px] leading-[1.5] text-text-secondary">
          <a href="mailto:delnorte.destinos@gmail.com" class="underline underline-offset-2 hover:text-accent">delnorte.destinos@gmail.com</a>
        </p>
        <p class="text-[11px] leading-[1.5] text-text-secondary">
          {t(dict, "footer.copyright", { year: anio })}
        </p>

        <p class="text-[11px]">
          <LangSwitcher />
        </p>
        <p class="text-[11px]">
          <button
            type="button"
            data-install-app
            class="text-text-secondary underline underline-offset-2 hover:text-accent"
          >{dict.nav.installShort}</button>
        </p>
      </div>

      <a href={`${lbase}${base}`} aria-label={dict.nav.brandHome} class="self-start lg:self-center shrink-0">
        <img
          src={`${base}logo.png`}
          alt=""
          class="h-12 w-auto"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</footer>
