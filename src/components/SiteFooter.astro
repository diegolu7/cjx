---
import LangSwitcher from "./LangSwitcher.astro";
import { getDict, t, type Locale } from "../i18n/index.ts";
import { localeBase } from "../i18n/routes";

const base = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const lbase = localeBase(locale);
---

<footer id="info" class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-info">
      <p>{dict.footer.disclaimer}</p>
      <p>
        {dict.footer.data}{" "}
        <a href="https://www.espn.com/soccer/" rel="noopener noreferrer nofollow" target="_blank">ESPN</a>.
      </p>
      <nav aria-label={dict.nav.legal} class="footer-links">
        <a href={`${lbase}${base}info`}>{dict.nav.info}</a>
        <a href={`${lbase}${base}terminos`}>{dict.footer.terms}</a>
        <a href={`${lbase}${base}privacidad`}>{dict.footer.privacy}</a>
        <a href={`${lbase}${base}cookies`}>{dict.footer.cookiesLink}</a>
        <a href={`${lbase}${base}contacto`}>{dict.footer.contact}</a>
      </nav>
      <p>
        {dict.footer.cookiesText}{" "}
        <a href={`${lbase}${base}cookies`}>{dict.footer.cookiesPolicy}</a>.
      </p>
      <p>
        <a href="mailto:delnorte.destinos@gmail.com">delnorte.destinos@gmail.com</a>
      </p>
      <p>{t(dict, "footer.copyright", { year: anio })}</p>
    </div>
    <div class="footer-brand">
      <img src={`${base}logo.png`} alt="" class="footer-logo" loading="lazy" />
      <div class="footer-brand-text">
        <LangSwitcher />
        <button type="button" data-install-app class="footer-install">{dict.nav.install}</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 760px;
  }
  .footer-info p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 12px;
    line-height: 1.8;
  }
  .footer-info a {
    color: var(--color-accent-secondary);
    text-decoration: none;
  }
  .footer-info a:hover {
    text-decoration: underline;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .footer-links a {
    color: var(--color-text-muted);
  }
  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-align: right;
  }
  .footer-logo {
    width: 58px;
    height: 58px;
  }
  .footer-brand-text {
    color: #a1aec0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .footer-install {
    background: none;
    border: 0;
    color: var(--color-accent-strong);
    font: inherit;
    cursor: pointer;
    padding: 0;
  }

  @media (max-width: 960px) {
    .footer-brand {
      align-self: flex-start;
      text-align: left;
    }
  }
</style>
