---
// Footer según design.md §45/§46: disclaimer, links legales, contacto y logo.
const base = import.meta.env.BASE_URL;
const anio = new Date().getFullYear();
---

<footer class="site-footer border-t border-border">
  <div class="site-footer__inner">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-[11px] leading-[1.5] text-text-secondary">
          Sitio no oficial. No afiliado a AFA ni al Club Atlético Boca Juniors.
        </p>

        <nav aria-label="Legal" class="flex flex-wrap gap-x-4 gap-y-1">
          <a href={`${base}info`} class="text-[11px] text-text-muted underline underline-offset-2 hover:text-text-secondary">Info</a>
          <a href={`${base}terminos`} class="text-[11px] text-text-muted underline underline-offset-2 hover:text-text-secondary">Términos</a>
          <a href={`${base}privacidad`} class="text-[11px] text-text-muted underline underline-offset-2 hover:text-text-secondary">Privacidad</a>
          <a href={`${base}cookies`} class="text-[11px] text-text-muted underline underline-offset-2 hover:text-text-secondary">Cookies</a>
          <a href={`${base}contacto`} class="text-[11px] text-text-muted underline underline-offset-2 hover:text-text-secondary">Contacto</a>
        </nav>

        <p class="text-[11px] leading-[1.5] text-text-muted">
          <a href="mailto:delnorte.destinos@gmail.com" class="underline underline-offset-2 hover:text-text-secondary">delnorte.destinos@gmail.com</a>
          · © {anio} Cuando Juega el Xeneize
        </p>
      </div>

      <a href={`${base}`} aria-label="Cuando Juega el Xeneize — Inicio" class="self-start lg:self-center shrink-0">
        <img
          src={`${base}logo.png`}
          alt=""
          class="h-12 w-auto"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</footer>
