---
// Google Analytics 4 — se carga SOLO si el usuario aceptó (cookie banner).
// Reemplazar el placeholder por el Measurement ID real (ej. G-XXXXXXXXXX).
const GA_ID = "G-XXXXXXXXXX";
---

<script is:inline define:vars={{ GA_ID }}>
  window.cjxLoadAnalytics = function () {
    if (window.__cjxGaLoaded) return;
    window.__cjxGaLoaded = true;

    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
    document.head.appendChild(s);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", GA_ID, { anonymize_ip: true });
  };

  try {
    if (localStorage.getItem("cjx:consent") === "granted") {
      window.cjxLoadAnalytics();
    }
  } catch (e) {
    /* storage no disponible */
  }
</script>
