---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const vapidPublic = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY;
const configured = Boolean(supabaseUrl && vapidPublic);
---

<section id="notificaciones" class="not-scroll-mt">
  <h2>Notificaciones</h2>

  {configured ? (
    <div id="notify-box" data-supabase={supabaseUrl} data-vapid={vapidPublic}>
      <p>
        Activá avisos y te notificamos antes de que juegue Boca y con el resultado final. Podés
        elegir qué querés recibir.
      </p>

      <div class="mt-3 flex flex-col gap-2">
        <label class="flex items-center gap-2 text-[13px] text-text-secondary">
          <input type="checkbox" data-pref="h1" checked class="h-4 w-4 accent-[#D9A441]" />
          1 hora antes del partido
        </label>
        <label class="flex items-center gap-2 text-[13px] text-text-secondary">
          <input type="checkbox" data-pref="h24" class="h-4 w-4 accent-[#D9A441]" />
          24 horas antes
        </label>
        <label class="flex items-center gap-2 text-[13px] text-text-secondary">
          <input type="checkbox" data-pref="result" checked class="h-4 w-4 accent-[#D9A441]" />
          Resultado final
        </label>
      </div>

      <div class="mt-4">
        <button
          type="button"
          id="notify-toggle"
          class="h-10 rounded-[6px] border border-accent bg-accent px-4 text-[12px] font-semibold uppercase tracking-[0.04em] text-bg transition-colors hover:border-accent-strong hover:bg-accent-strong"
        >
          Activar notificaciones
        </button>
      </div>

      <p id="notify-status" class="mt-3 text-[12px] text-text-muted"></p>
      <p id="notify-ios" hidden class="mt-2 text-[12px] text-text-muted">
        En iPhone/iPad primero instalá la app (Compartir → Agregar a pantalla de inicio) y luego
        activá las notificaciones desde el ícono instalado.
      </p>
    </div>
  ) : (
    <p>
      <strong>Próximamente:</strong> vas a poder activar avisos para que te notifiquemos cuando esté
      por jugar Boca y con el resultado final.
    </p>
  )}
</section>

<script>
  (function () {
    var box = document.getElementById("notify-box") as HTMLElement | null;
    if (!box) return;

    var supabaseUrl = (box.dataset.supabase || "").replace(/\/$/, "");
    var vapid = box.dataset.vapid || "";
    var statusEl = document.getElementById("notify-status");
    var toggleBtn = document.getElementById("notify-toggle") as HTMLButtonElement | null;
    var iosEl = document.getElementById("notify-ios");
    var prefEls = Array.from(box.querySelectorAll<HTMLInputElement>("[data-pref]"));

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }
    function getPrefs(): Record<string, boolean> {
      var p: Record<string, boolean> = {};
      prefEls.forEach(function (el) {
        p[el.dataset.pref as string] = el.checked;
      });
      return p;
    }
    function urlBase64ToUint8Array(base64String: string): Uint8Array {
      var padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      var base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      var raw = atob(base64);
      var arr = new Uint8Array(raw.length);
      for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
      return arr;
    }

    var supported = "serviceWorker" in navigator && "PushManager" in window;
    var standalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      (navigator as any).standalone === true;
    var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

    if (!supported) {
      setStatus("Tu navegador no soporta notificaciones.");
      if (toggleBtn) toggleBtn.disabled = true;
      return;
    }
    if (isIOS && !standalone && iosEl) iosEl.hidden = false;

    async function currentSubscription(): Promise<PushSubscription | null> {
      var reg = await navigator.serviceWorker.getRegistration();
      if (!reg) reg = await navigator.serviceWorker.ready;
      return reg.pushManager.getSubscription();
    }

    async function save(sub: PushSubscription, prefs: Record<string, boolean>, enabled: boolean) {
      var json = sub.toJSON();
      await fetch(supabaseUrl + "/functions/v1/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          endpoint: json.endpoint,
          keys: json.keys,
          prefs: prefs,
          enabled: enabled,
        }),
      });
    }

    async function refresh() {
      var sub = await currentSubscription();
      if (!toggleBtn) return;
      toggleBtn.textContent = sub ? "Desactivar notificaciones" : "Activar notificaciones";
      if (sub) setStatus("Notificaciones activadas.");
    }

    if (!toggleBtn) return;
    const btn = toggleBtn;
    btn.addEventListener("click", async function () {
      try {
        var existing = await currentSubscription();
        if (existing) {
          await save(existing, getPrefs(), false);
          await existing.unsubscribe();
          setStatus("Notificaciones desactivadas.");
          btn.textContent = "Activar notificaciones";
          return;
        }
        var perm = await Notification.requestPermission();
        if (perm !== "granted") {
          setStatus("Permiso denegado. Podés habilitarlo desde el navegador.");
          return;
        }
        var reg = await navigator.serviceWorker.ready;
        var sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapid) as unknown as BufferSource,
        });
        await save(sub, getPrefs(), true);
        setStatus("¡Listo! Vas a recibir los avisos.");
        btn.textContent = "Desactivar notificaciones";
      } catch (e) {
        setStatus("No se pudo activar: " + ((e as Error).message || e));
      }
    });

    prefEls.forEach(function (el) {
      el.addEventListener("change", async function () {
        var sub = await currentSubscription();
        if (sub) {
          await save(sub, getPrefs(), true);
          setStatus("Preferencias guardadas.");
        }
      });
    });

    refresh();
  })();
</script>
