---
import { getDict, type Locale } from "../i18n/index.ts";

interface Props {
  hideWhenUnconfigured?: boolean;
  compact?: boolean;
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const vapidPublic = import.meta.env.PUBLIC_VAPID_PUBLIC_KEY;
const configured = Boolean(supabaseUrl && vapidPublic);
const { hideWhenUnconfigured = false, compact = false } = Astro.props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
---

{(!configured && hideWhenUnconfigured) ? null : compact ? (
  <div class="rounded-lg border border-border bg-surface p-4 shadow-card">
    <p class="text-[13px] leading-[1.6] text-text-secondary">
      {dict.notify.compact}
    </p>
    <div class="mt-3">
      <button
        type="button"
        data-notify-toggle
        class="h-10 rounded-[6px] border border-accent bg-accent px-4 text-[12px] font-semibold uppercase tracking-[0.04em] text-bg transition-colors hover:border-accent-strong hover:bg-accent-strong"
      >
        {dict.notify.enableShort}
      </button>
    </div>
    <p data-notify-status class="mt-3 text-[12px] text-text-muted" aria-live="polite"></p>
    <p data-notify-ios hidden class="mt-2 text-[12px] text-text-muted">
      {dict.notify.ios}
    </p>
  </div>
) : (
  <section id="notificaciones" class="mt-8 scroll-mt-6">
    <h2 class="text-[17px] font-bold tracking-[0.02em] text-text-primary">{dict.notify.title}</h2>

    {configured ? (
      <div class="mt-3 rounded-lg border border-border bg-surface p-4 shadow-card">
        <p class="text-[13px] leading-[1.6] text-text-secondary">
          {dict.notify.full}
        </p>

        <div class="mt-4">
          <button
            type="button"
            data-notify-toggle
            class="h-10 rounded-[6px] border border-accent bg-accent px-4 text-[12px] font-semibold uppercase tracking-[0.04em] text-bg transition-colors hover:border-accent-strong hover:bg-accent-strong"
          >
            {dict.notify.enable}
          </button>
        </div>

        <p data-notify-status class="mt-3 text-[12px] text-text-muted" aria-live="polite"></p>
        <p data-notify-ios hidden class="mt-2 text-[12px] text-text-muted">
          {dict.notify.ios}
        </p>
      </div>
    ) : (
      <p class="mt-3 text-[13px] leading-[1.6] text-text-secondary">
        <strong class="text-text-primary">{dict.notify.soonLabel}</strong> {dict.notify.soon}
      </p>
    )}
  </section>
)}
