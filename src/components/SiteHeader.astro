---
import LangSwitcher from "./LangSwitcher.astro";
import Icon from "./match/Icon.astro";
import { getDict, type Locale } from "../i18n/index.ts";
import { localeBase } from "../i18n/routes";

const base = import.meta.env.BASE_URL;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const lbase = localeBase(locale);
const pathname = Astro.url.pathname;
const isHome = pathname === `${base}` || pathname === `${base.replace(/\/$/, "")}` || pathname === "/" || pathname === "/en" || pathname === "/en/";
const notifyConfigured = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_VAPID_PUBLIC_KEY,
);
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={`${lbase}${base}`} class="brand" aria-label={dict.nav.brandHome}>
      <img
        src={`${base}logo.png`}
        alt=""
        width={40}
        height={40}
        class="brand-logo"
        loading="eager"
      />
      <span class="brand-text">CUANDO JUEGA <em>EL XENEIZE</em></span>
    </a>

    <nav aria-label={dict.nav.main} class="hidden lg:flex items-center gap-[14px] xl:gap-[22px]">
      <a href={`${lbase}${base}`} class={`nav-link ${isHome ? "nav-link--active" : ""}`} aria-current={isHome ? "page" : undefined}>
        {dict.nav.home.toUpperCase()}
      </a>
      <a href={`${lbase}${base}info`} class="nav-link">{dict.nav.info.toUpperCase()}</a>
      <LangSwitcher />
      {notifyConfigured && (
        <button type="button" data-notify-open class="nav-alert" aria-haspopup="dialog">
          <Icon name="bell" size={14} />
          <span data-notify-label>{dict.nav.alerts}</span>
        </button>
      )}
      <button type="button" data-install-app class="nav-link bg-transparent border-0 p-0 cursor-pointer">
        {dict.nav.install.toUpperCase()}
        <span class="nav-install">↓</span>
      </button>
    </nav>

    <details class="site-menu lg:hidden relative">
      <summary class="hamburger" aria-label={dict.nav.openMenu} aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="site-menu__panel">
        <a href={`${lbase}${base}`} aria-current={isHome ? "page" : undefined}>{dict.nav.home}</a>
        <a href={`${lbase}${base}info`}>{dict.nav.info}</a>
        <LangSwitcher />
        {notifyConfigured && (
          <button type="button" data-notify-open class="nav-alert site-menu__alert" aria-haspopup="dialog">
            <Icon name="bell" size={14} />
            <span data-notify-label>{dict.nav.alerts}</span>
          </button>
        )}
        <button type="button" data-install-app>
          {dict.nav.install}
        </button>
      </div>
    </details>
  </div>
</header>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 31px;
    font-weight: 800;
    letter-spacing: 0.2px;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand em {
    color: var(--color-accent-strong);
    font-style: normal;
  }
  .brand-logo {
    width: 40px;
    height: 40px;
  }
  .nav-install {
    color: var(--color-accent-strong);
    margin-left: 4px;
  }
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    background: none;
    border: 0;
    width: 39px;
    height: 40px;
    padding: 8px;
  }
  .hamburger span {
    height: 2px;
    width: 23px;
    background: #174782;
  }
  .site-menu[open] .hamburger span {
    background: var(--color-text-primary);
  }

  @media (max-width: 960px) {
    .brand {
      font-size: 23px;
      line-height: 0.95;
      max-width: 285px;
    }
    .brand em {
      display: block;
    }
    .brand-logo {
      width: 33px;
      height: 33px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".site-menu").forEach((menu) => {
    const summary = menu.querySelector("summary");
    menu.querySelectorAll<HTMLElement>(".site-menu__panel a, .site-menu__panel button").forEach((item) => {
      item.addEventListener("click", () => {
        menu.open = false;
      });
    });
    document.addEventListener("click", (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.open = false;
        summary?.focus();
      }
    });
    window.addEventListener(
      "scroll",
      () => {
        if (menu.open) menu.open = false;
      },
      { passive: true },
    );
    menu.addEventListener("toggle", () => {
      summary?.setAttribute("aria-expanded", String(menu.open));
    });
  });
</script>
