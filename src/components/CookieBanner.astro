---
const base = import.meta.env.BASE_URL;
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-banner__text">
    Usamos almacenamiento local para el funcionamiento del sitio y, con tu permiso, cookies de
    estadísticas (Google Analytics 4 y Microsoft Clarity) para saber cómo se usa. Podés aceptar o
    rechazar las de estadísticas. Más info en la <a href={`${base}cookies`}>política de cookies</a>.
  </p>
  <div class="cookie-banner__actions">
    <button id="cookie-accept" type="button" class="cookie-banner__btn cookie-banner__btn--accept">
      Aceptar
    </button>
    <button id="cookie-reject" type="button" class="cookie-banner__btn cookie-banner__btn--reject">
      Rechazar
    </button>
  </div>
</div>

<script>
  (function () {
    var KEY = "cjx:consent";
    var banner = document.getElementById("cookie-banner");

    var choice = null;
    try {
      choice = localStorage.getItem(KEY);
    } catch (e) {
      /* storage no disponible */
    }

    if (!choice && banner) banner.hidden = false;

    function decide(value: string) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {
        /* storage no disponible */
      }
      if (banner) banner.hidden = true;
      if (value === "granted" && typeof (window as any).cjxLoadAnalytics === "function") {
        (window as any).cjxLoadAnalytics();
      }
    }

    var accept = document.getElementById("cookie-accept");
    var reject = document.getElementById("cookie-reject");
    if (accept) accept.addEventListener("click", function () { decide("granted"); });
    if (reject) reject.addEventListener("click", function () { decide("denied"); });
  })();
</script>
