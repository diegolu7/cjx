---
import type { Match, MatchDetails } from "../../types/match";
import Icon from "./Icon.astro";

interface Props {
  match: Match;
  details?: MatchDetails;
}
const { match, details } = Astro.props;

const items = [
  { icon: "mapPin", label: "Estadio", value: match.venue || "A confirmar" },
  {
    icon: "trophy",
    label: "Torneo",
    value: `${match.competition}${match.round ? ` · ${match.round}` : ""}`,
  },
  { icon: "user", label: "Árbitro", value: details?.referee || "A confirmar" },
  { icon: "tv", label: "TV", value: match.channel || "A confirmar" },
];
---

<section class="mb-6">
  <h2 class="sr-only">Datos del partido</h2>
  <div class="grid grid-cols-2 gap-x-4 gap-y-4 rounded-lg border border-border bg-surface shadow-card px-4 py-4">
    {items.map((it) => (
      <div class="flex items-start gap-2.5">
        <span class="mt-[2px] text-accent-secondary">
          <Icon name={it.icon} size={18} />
        </span>
        <div class="min-w-0">
          <p class="text-[11px] uppercase tracking-[0.04em] text-text-muted">{it.label}</p>
          <p class="text-[13px] leading-[1.4] text-text-primary">{it.value}</p>
        </div>
      </div>
    ))}
  </div>
</section>
