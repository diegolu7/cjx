---
import type { Match } from "../../types/match";
import Icon from "./Icon.astro";
import { fechaLarga, lugarDe, canalDe, competitionLabel, roundLabel } from "../../lib/match";
import { getDict, type Locale } from "../../i18n/index.ts";

interface Props {
  match: Match;
  includeDate?: boolean;
}
const { match, includeDate = false } = Astro.props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);

const items = [
  ...(includeDate
    ? [{ icon: "calendar", label: dict.match.labelDate, value: fechaLarga(match.date, dict), sub: undefined }]
    : []),
  {
    icon: "mapPin",
    label: dict.match.labelVenue,
    value: lugarDe(match) || dict.match.venueTbd,
    sub: match.venueCity,
  },
  {
    icon: "trophy",
    label: dict.match.labelTournament,
    value: competitionLabel(match, dict),
    sub: roundLabel(match, dict),
  },
  ...(canalDe(match)
    ? [{ icon: "tv", label: "TV", value: canalDe(match) as string, sub: undefined }]
    : []),
];
---

<div class="grid grid-cols-2 gap-x-4 gap-y-3 lg:grid-cols-4">
  {items.map((it) => (
    <div class="flex items-start gap-2.5">
      <span class="mt-[2px] text-accent-secondary">
        <Icon name={it.icon} size={16} />
      </span>
      <div class="min-w-0">
        <p class="text-[11px] uppercase tracking-[0.04em] text-text-muted">{it.label}</p>
        <p class="text-[13px] leading-[1.4] text-text-primary">{it.value}</p>
        {it.sub && <p class="text-[12px] leading-[1.4] text-text-secondary">{it.sub}</p>}
      </div>
    </div>
  ))}
</div>
