---
import { getDict, t, type Locale } from "../../i18n/index.ts";

interface Props {
  title: string;
  text: string;
  referee?: string;
}
const { title, text, referee } = Astro.props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
---

<section class="mb-6">
  <h2 class="text-[15px] font-bold text-text-primary mb-2">{title}</h2>
  {text.split(/\n+/).map((p) => (
    <p class="text-[14px] leading-[1.7] text-text-secondary mt-2">{p}</p>
  ))}
  {referee && (
    <p class="text-[14px] leading-[1.7] text-text-secondary mt-2">
      {t(dict, "sections.referee", { referee })}
    </p>
  )}
</section>
