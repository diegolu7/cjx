---
// Línea de fixture: local vs visitante.
//
// Un solo DOM para mobile y desktop (design.md §51):
//   - mobile: dos filas (escudo · nombre · marcador). Los nombres largos envuelven
//     en varias líneas, nunca se cortan con "..." (§31.2/§31.4).
//   - desktop: una sola línea "BOCA 2 - 1 VASCO" con ellipsis si no entra (§20).
import type { Match } from "../../types/match";
import Crest from "./Crest.astro";

interface Props {
  match: Match;
  /** Muestra el escudo de cada equipo (cards de lista). */
  crests?: boolean;
  /** "featured" = destacado de la home; "compact" = card de lista. */
  size?: "featured" | "compact";
  class?: string;
}
const { match, crests = true, size = "compact", class: className } = Astro.props;

const hasScore = match.homeScore !== undefined && match.awayScore !== undefined;
const sep = hasScore ? "-" : "vs";

// Tipografía adaptativa en el destacado: con nombres largos el título baja un
// escalón en vez de recortarse.
const nameMax = Math.max(match.homeTeam.length, match.awayTeam.length);
const featuredSize =
  nameMax <= 14
    ? "text-[18px] lg:text-[20px]"
    : nameMax <= 20
      ? "text-[17px] lg:text-[19px]"
      : nameMax <= 26
        ? "text-[16px] lg:text-[18px]"
        : "text-[15px] lg:text-[17px]";

const nameClass =
  size === "featured"
    ? `${featuredSize} font-bold uppercase leading-[1.2] text-text-primary`
    : "text-[15px] leading-[1.25] font-semibold text-text-primary";

const scoreClass =
  size === "featured"
    ? `${featuredSize} font-bold leading-[1.2] text-text-primary tabular-nums`
    : "text-[15px] leading-[1.25] font-semibold text-text-primary tabular-nums";

// Mobile: grid de 2 filas (ajustada al contenido, para que el marcador no quede
// lejos del nombre). Desktop: flex de una sola fila.
const gridClass = crests
  ? "grid w-fit max-w-full grid-cols-[auto_minmax(0,1fr)_auto] lg:flex lg:w-full lg:flex-nowrap lg:items-center gap-x-2 gap-y-1"
  : "grid w-fit max-w-full grid-cols-[minmax(0,1fr)_auto] lg:flex lg:w-full lg:flex-nowrap lg:items-center gap-x-2 gap-y-1";

// Áreas del grid (mobile). En desktop (flex) el orden lo define el DOM.
const area = {
  homeCrest: "[grid-area:1/1/2/2]",
  homeName: crests ? "[grid-area:1/2/2/3]" : "[grid-area:1/1/2/2]",
  homeScore: crests ? "[grid-area:1/3/2/4]" : "[grid-area:1/2/2/3]",
  sep: "hidden lg:inline lg:px-1",
  awayScore: crests ? "[grid-area:2/3/3/4]" : "[grid-area:2/2/3/3]",
  awayName: crests ? "[grid-area:2/2/3/3]" : "[grid-area:2/1/3/2]",
  awayCrest: "[grid-area:2/1/3/2]",
};
---

<div class:list={[gridClass, className]} data-fixture>
  {crests && (
    <span class={area.homeCrest}>
      <Crest src={match.homeLogo} name={match.homeTeam} size={size === "featured" ? 28 : 20} />
    </span>
  )}

  <span
    class:list={[area.homeName, nameClass, "min-w-0 break-words lg:truncate"]}
    title={match.homeTeam}
    data-fixture-team="home"
  >
    {match.homeTeam}
  </span>

  {hasScore && (
    <span class:list={[area.homeScore, scoreClass]}>{match.homeScore}</span>
  )}

  <span class:list={[area.sep, nameClass, "opacity-70"]}>{sep}</span>

  {hasScore && (
    <span class:list={[area.awayScore, scoreClass]}>{match.awayScore}</span>
  )}

  <span
    class:list={[area.awayName, nameClass, "min-w-0 break-words lg:truncate"]}
    title={match.awayTeam}
    data-fixture-team="away"
  >
    {match.awayTeam}
  </span>

  {crests && (
    <span class={area.awayCrest}>
      <Crest src={match.awayLogo} name={match.awayTeam} size={size === "featured" ? 28 : 20} />
    </span>
  )}
</div>
