---
import { splitByFormation } from "../../lib/match";

interface Props {
  formation?: string;
  players: string[];
}
const { formation, players } = Astro.props;

const lines = splitByFormation(formation, players);
// Válido solo si se pudo dividir en líneas (Arquero/Defensores/…).
const valid = lines.length > 1;
// Delanteros arriba, arquero abajo.
const rows = valid ? [...lines].reverse() : [];
---

{valid && (
  <div class="relative overflow-hidden rounded-lg border border-border bg-[#0c2117] px-2 py-4">
    <!-- Líneas de cancha (decorativas) -->
    <span class="pointer-events-none absolute inset-x-0 top-1/2 h-px bg-white/10"></span>
    <span
      class="pointer-events-none absolute left-1/2 top-1/2 h-20 w-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/10"
    ></span>
    <span class="pointer-events-none absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-white/[0.06]"></span>

    <div class="relative flex flex-col gap-5">
      {rows.map((line) => (
        <div class="flex items-start justify-around gap-1">
          {line.players.map((p) => (
            <div class="flex w-14 min-w-0 flex-col items-center">
              <span class="flex h-7 w-7 items-center justify-center rounded-full border border-accent-secondary/60 bg-surface"></span>
              <span class="mt-1 w-full truncate text-center text-[10px] leading-tight text-text-primary">
                {p}
              </span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
)}
