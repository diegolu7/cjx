---
import type { Match, MatchDetails } from "../../types/match";
import { splitByFormation, rivalOf } from "../../lib/match";
import Notifications from "../Notifications.astro";
import Pitch from "./Pitch.astro";
import { getDict, t, type Locale } from "../../i18n/index.ts";

interface Props {
  match: Match;
  details?: MatchDetails;
  upcoming: boolean;
}
const { match, details, upcoming } = Astro.props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);

const rival = rivalOf(match);
const available =
  (details?.startersBoca?.length ?? 0) > 0 || (details?.startersRival?.length ?? 0) > 0;

const bocaTeam = {
  name: "Boca",
  formation: details?.formationBoca,
  players: details?.startersBoca ?? [],
  lines: splitByFormation(details?.formationBoca, details?.startersBoca ?? [], dict),
  subs: details?.subsBoca ?? [],
};
const rivalTeam = {
  name: rival,
  formation: details?.formationRival,
  players: details?.startersRival ?? [],
  lines: splitByFormation(details?.formationRival, details?.startersRival ?? [], dict),
  subs: details?.subsRival ?? [],
};

// Local = homeTeam; visitante = awayTeam.
const local = match.homeTeam === "Boca" ? bocaTeam : rivalTeam;
const visitor = match.homeTeam === "Boca" ? rivalTeam : bocaTeam;

const cancha = local.lines.length > 1 && visitor.lines.length > 1;
const chip =
  "inline-flex h-6 items-center rounded-[4px] border border-accent-secondary/60 px-2 text-[11px] font-semibold text-accent-secondary";
---

<section class="mb-6">
  <h2 class="text-[15px] font-bold text-text-primary mb-2">
    {dict.sections.lineups}{upcoming && available ? dict.sections.lineupsProbable : ""}
  </h2>

  {!available ? (
    <div class="rounded-lg border border-border bg-surface shadow-card px-4 py-4">
      <p class="text-[13px] leading-[1.6] text-text-secondary">
        {dict.sections.lineupsSoon}
      </p>
      {upcoming && (
        <p class="mt-1 text-[12px] text-text-muted">
          {dict.sections.lineupsNotify}
        </p>
      )}
    </div>
  ) : (
    <>
      {upcoming && (
        <p class="mb-3 text-[11px] text-text-muted">
          {dict.sections.lineupsUnofficial}
        </p>
      )}

      {cancha ? (
        <>
          <div class="mb-2 flex items-center justify-between gap-2 text-[12px]">
            <span class="flex items-center gap-2">
              <span class="font-semibold text-text-primary">{local.name}</span>
              {local.formation && <span class={chip}>{local.formation}</span>}
            </span>
            <span class="flex items-center gap-2">
              {visitor.formation && <span class={chip}>{visitor.formation}</span>}
              <span class="font-semibold text-text-primary">{visitor.name}</span>
            </span>
          </div>
          <Pitch local={local} visitor={visitor} />
        </>
      ) : (
        <div class="grid gap-4 lg:grid-cols-2">
          {[bocaTeam, rivalTeam].map((t) => (
            <div class="rounded-lg border border-border bg-surface shadow-card px-3 py-3">
              <p class="text-[13px] font-semibold text-text-primary">{t.name}</p>
              <p class="mt-2 text-[13px] leading-[1.7] text-text-secondary">
                {t.players.join(", ")}
              </p>
            </div>
          ))}
        </div>
      )}

      <div class="mt-3 grid gap-2 lg:grid-cols-2">
        {[local, visitor].map(
          (team) =>
            team.subs.length > 0 && (
              <details class="rounded-lg border border-border bg-surface px-3 py-2">
                <summary class="cursor-pointer text-[12px] text-text-muted">
                  {t(dict, "sections.subs", { team: team.name, count: team.subs.length })}
                </summary>
                <p class="mt-1 text-[12px] leading-[1.6] text-text-muted">{team.subs.join(", ")}</p>
              </details>
            ),
        )}
      </div>
    </>
  )}

  {upcoming && (
    <div class="mt-3">
      <Notifications compact />
    </div>
  )}
</section>
