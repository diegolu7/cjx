---
import type { Match } from "../../types/match";
import { faqFor } from "../../lib/match";
import { getDict, type Locale } from "../../i18n/index.ts";

interface Props {
  match: Match;
}
const { match } = Astro.props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const faqs = faqFor(match, dict);
---

{faqs.length > 0 && (
  <section class="mb-6">
    <h2 class="text-[15px] font-bold text-text-primary mb-2">{dict.sections.faq}</h2>
    <dl class="flex flex-col gap-3">
      {faqs.map((f) => (
        <div class="rounded-lg border border-border bg-surface shadow-card px-4 py-3">
          <dt class="text-[13px] font-semibold text-text-primary">{f.q}</dt>
          <dd class="mt-1 text-[13px] leading-[1.6] text-text-secondary">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
