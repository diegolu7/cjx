---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import CookieBanner from "../components/CookieBanner.astro";
import InstallPrompt from "../components/InstallPrompt.astro";
import SeoHead from "../components/SeoHead.astro";
import { getDict, HTML_LANG, type Locale } from "../i18n/index.ts";
import { esPathWithSlash, enPathWithSlash, localeBase } from "../i18n/routes";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const base = import.meta.env.BASE_URL;
const { title, description, image, noindex } = Astro.props;

const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const htmlLang = HTML_LANG[locale];
const lbase = localeBase(locale);

const pageTitle = title ?? dict.meta.defaultTitle;
const pageDescription = description ?? dict.meta.defaultDescription;
const pageImage = image ?? (locale === "en" ? `${base}en/og.png` : `${base}og.png`);

const siteUrl = new URL(base, Astro.site).href;
const pathname = Astro.url.pathname;

// Versiones alternativas de esta misma página (mismo path, distinto locale).
const esHref = new URL(esPathWithSlash(pathname), Astro.site).href;
const enHref = new URL(enPathWithSlash(pathname), Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: dict.meta.siteName,
      url: siteUrl,
      inLanguage: HTML_LANG[locale],
    },
    {
      "@type": "Organization",
      name: dict.meta.siteName,
      url: siteUrl,
      logo: new URL(`${base}logo.png`, Astro.site).href,
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon.png?v=3`} />
    <link rel="icon" sizes="144x144 96x96 48x48 32x32 16x16" href={`${base}favicon.ico?v=3`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={dict.meta.siteName}
      href={`${lbase}${base}feed.xml`}
    />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png?v=3`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={dict.meta.appName} />
    <meta name="theme-color" content="#07111F" />
    <meta name="google-adsense-account" content="ca-pub-7674492293428072" />
    <SeoHead
      title={pageTitle}
      description={pageDescription}
      image={pageImage}
      noindex={noindex}
      locale={locale}
      esHref={esHref}
      enHref={enHref}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Idioma del navegador: si el visitante llega con el navegador en inglés y
         nunca eligió idioma, lo mandamos a /en/ (una sola vez, con localStorage).
         Se apaga con AUTO_REDIRECT=false al buildear. -->
    {__AUTO_REDIRECT__ && (
    <script is:inline>
      (function () {
        try {
          var KEY = "cjx:lang";
          var pref = localStorage.getItem(KEY);
          if (!pref) {
            var langs = navigator.languages || [navigator.language || ""];
            for (var i = 0; i < langs.length; i++) {
              var l = (langs[i] || "").split("-")[0].toLowerCase();
              if (l === "en" || l === "es") {
                pref = l;
                break;
              }
            }
            if (pref) localStorage.setItem(KEY, pref);
          }
          if (pref !== "en") return;
          var p = location.pathname;
          if (p === "/en" || p.indexOf("/en/") === 0) return;
          location.replace("/en" + p + location.search + location.hash);
        } catch (e) {
          /* sin localStorage o sin permisos: seguimos en español */
        }
      })();
    </script>
    )}
  </head>
  <body class="min-h-screen bg-bg text-text-primary flex flex-col">
    <div class="site">
      <SiteHeader />
      <main class="site-main flex-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <Analytics />
    <CookieBanner />
    <InstallPrompt />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ base }}>
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register(base + "sw.js", { scope: base }).catch(function () {});
          });
        }
      </script>
    )}
  </body>
</html>
