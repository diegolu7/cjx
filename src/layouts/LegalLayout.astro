---
import Layout from "./Layout.astro";
import { getDict, type Locale } from "../i18n/index.ts";
import { localeBase } from "../i18n/routes";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const locale = (Astro.currentLocale ?? "es") as Locale;
const dict = getDict(locale);
const base = import.meta.env.BASE_URL;
const lbase = localeBase(locale);
const { title, description, updated = "Septiembre 2026" } = Astro.props;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: dict.match.breadcrumbHome,
      item: new URL(`${lbase}${base}`, Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: new URL(Astro.url.pathname, Astro.site).href,
    },
  ],
};
---

<Layout title={`${title} — ${dict.meta.siteName}`} description={description}>
  <article class="legal">
    <h1>{title}</h1>
    <p class="legal__updated">{dict.pages.legal.updated.replace("{date}", updated)}</p>
    <slot />
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</Layout>
