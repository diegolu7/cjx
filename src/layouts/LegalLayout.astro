---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const base = import.meta.env.BASE_URL;
const { title, description, updated = "Septiembre 2026" } = Astro.props;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL(base, Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: title,
      item: new URL(Astro.url.pathname, Astro.site).href,
    },
  ],
};
---

<Layout title={`${title} — Cuando Juega el Xeneize`} description={description}>
  <article class="legal">
    <h1>{title}</h1>
    <p class="legal__updated">Última actualización: {updated}</p>
    <slot />
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
</Layout>
