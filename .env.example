# Variables de entorno — Web Push

# --- Públicas (se exponen en el cliente; se inyectan en el build) ---
# URL de tu proyecto Supabase
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública VAPID (generada con: npx web-push generate-vapid-keys)
PUBLIC_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY

# --- Solo para el emisor (scripts/notify.mjs) — NO van al cliente ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SEND_SECRET=un-token-largo-y-aleatorio

# --- Solo para el keepalive (scripts/keepalive.mjs) — NO van al cliente ---
# Evita que el plan Free pause el proyecto a los 7 días sin actividad en la base.
# Debe ser IGUAL al secret PING_SECRET configurado en Supabase.
PING_SECRET=otro-token-largo-y-aleatorio

# --- Secrets de las Edge Functions (se configuran en Supabase, no acá) ---
# supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:... SEND_SECRET=... PING_SECRET=...
